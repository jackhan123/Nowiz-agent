# Required: OpenAI-compatible text gateway
COSHAPE_GATEWAY_API_KEY=replace_with_server_key

# Optional: use a separate image-generation key
COSHAPE_IMAGE_API_KEY=replace_with_image_key

# OpenAI-compatible API base URL and models
COSHAPE_API_BASE_URL=https://api.example.com/v1
COSHAPE_CHAT_MODEL=your_chat_model
COSHAPE_IMAGE_MODEL=your_image_model

# Optional: comma-separated HTTPS hosts used by image URL responses
COSHAPE_IMAGE_DOWNLOAD_HOSTS=
